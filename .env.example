# Copy this file to .env and fill in the values. .env is never committed.
# Quarkus and docker compose both read it.

# Database. For local builds these must match the jooq.codegen.jdbc.* values in pom.xml.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Customer login, see README.md. Remove or comment out the lines of a provider that
# is not used; empty values are not allowed.
# IServ: the school's IServ address without trailing slash, e.g. https://mein-iserv.de
TICKET_SSO_ISERV_URL=
TICKET_SSO_ISERV_CLIENT_ID=
TICKET_SSO_ISERV_CLIENT_SECRET=
# Moodle with the plugin "OAuth2 Server" (local_oauth2), e.g. https://moodle.example.com
TICKET_SSO_MOODLE_URL=
TICKET_SSO_MOODLE_CLIENT_ID=
TICKET_SSO_MOODLE_CLIENT_SECRET=

# Production only: where backend and website are reachable, without trailing slash
# TICKET_SSO_BACKEND_URL=https://tickets.example.com/api
# TICKET_FRONTEND_URL=https://tickets.example.com

# Encrypts the admin login cookie. At least 32 random characters: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# The bank account shown in the payment email
BANK_RECIPIENT=
BANK_IBAN=

# Sender address of all emails, e.g. tickets@noreply.example.com
MAIL_FROM=
# Where customers can ask for help, e.g. support@example.com. Named in every email and used
# as its Reply-To. Set it up at the mail provider to forward to the admin's own mailbox.
SUPPORT_EMAIL=

# The mail server (SMTP) that sends as MAIL_FROM; the values come from the mail provider.
# Port 587: MAIL_TLS=false and MAIL_START_TLS=REQUIRED. Port 465: MAIL_TLS=true and
# MAIL_START_TLS=DISABLED. Always required; in dev mode or with QUARKUS_MAILER_MOCK=true
# emails are only written to the log and placeholder values are fine.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TLS=false
MAIL_START_TLS=REQUIRED

# Without a mail server (e.g. trying the backend with docker compose): emails are only
# written to the log. Never in production.
# QUARKUS_MAILER_MOCK=true
