# Copy this file to .env and fill in the values. .env is never committed.
# Quarkus and docker compose both read it.

# Database. For local builds these must match the jooq.codegen.jdbc.* values in pom.xml.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Encrypts the admin login cookie. At least 32 random characters: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# The bank account shown in the payment email
BANK_RECIPIENT=
BANK_IBAN=

# Sender address of all emails, e.g. tickets@noreply.example.com
MAIL_FROM=
# Where customers can ask for help, e.g. support@example.com. Named in every email and used
# as its Reply-To. Set it up at the mail provider to forward to the admin's own mailbox.
SUPPORT_EMAIL=

# Production only: the mail server (in dev mode emails are only written to the log)
# QUARKUS_MAILER_HOST=
# QUARKUS_MAILER_PORT=
# QUARKUS_MAILER_USERNAME=
# QUARKUS_MAILER_PASSWORD=
